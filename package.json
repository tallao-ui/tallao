{
  "name": "tallao",
  "version": "0.7.0",
  "description": "Svelte 5 UI kit for generative interfaces, extracted from the Kitsuden admin",
  "license": "MIT",
  "author": "Victor Antinori Broce (https://github.com/vigogami)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tallao-ui/tallao.git"
  },
  "private": true,
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./map": {
      "types": "./dist/map/index.d.ts",
      "svelte": "./dist/map/index.js",
      "default": "./dist/map/index.js"
    },
    "./code": {
      "types": "./dist/code/index.d.ts",
      "svelte": "./dist/code/index.js",
      "default": "./dist/code/index.js"
    },
    "./motion": {
      "types": "./dist/motion/index.d.ts",
      "svelte": "./dist/motion/index.js",
      "default": "./dist/motion/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build:demo": "vite build",
    "package": "svelte-package -o dist && publint",
    "prepare": "svelte-package -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "llms": "node scripts/llms.mjs",
    "kit:check": "pnpm --filter tallao-kit-check build && pnpm --filter tallao-kit-check test"
  },
  "peerDependencies": {
    "@codemirror/commands": "^6",
    "@codemirror/lang-javascript": "^6",
    "@codemirror/lang-json": "^6",
    "@codemirror/lang-markdown": "^6",
    "@codemirror/language": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "leaflet": "^1.9.4",
    "sveaflet": "^0.1.5",
    "svelte": "^5.29.0",
    "@lezer/highlight": "^1"
  },
  "peerDependenciesMeta": {
    "leaflet": {
      "optional": true
    },
    "sveaflet": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "@codemirror/commands": {
      "optional": true
    },
    "@codemirror/language": {
      "optional": true
    },
    "@codemirror/lang-markdown": {
      "optional": true
    },
    "@codemirror/lang-json": {
      "optional": true
    },
    "@codemirror/lang-javascript": {
      "optional": true
    },
    "@lezer/highlight": {
      "optional": true
    }
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/leaflet": "^1.9.22",
    "axe-core": "^4.14.0",
    "happy-dom": "^18.0.1",
    "jsdom": "^26.1.0",
    "leaflet": "^1.9.4",
    "publint": "^0.3.25",
    "sveaflet": "^0.1.5",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
