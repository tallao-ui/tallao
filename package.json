{
  "name": "tallao",
  "version": "0.8.0",
  "description": "Svelte 5 UI kit for generative interfaces, extracted from the Kitsuden admin",
  "keywords": [
    "svelte",
    "svelte5",
    "sveltekit",
    "ui",
    "components",
    "ui-kit",
    "design-system",
    "accessibility",
    "generative-ui",
    "ai",
    "mcp"
  ],
  "license": "MIT",
  "homepage": "https://tallao-ui.github.io/tallao/",
  "bugs": {
    "url": "https://github.com/tallao-ui/tallao/issues"
  },
  "author": "Victor Antinori Broce (https://github.com/vigogami)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tallao-ui/tallao.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tallao": "bin/tallao.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./map": {
      "types": "./dist/map/index.d.ts",
      "svelte": "./dist/map/index.js",
      "default": "./dist/map/index.js"
    },
    "./code": {
      "types": "./dist/code/index.d.ts",
      "svelte": "./dist/code/index.js",
      "default": "./dist/code/index.js"
    },
    "./motion": {
      "types": "./dist/motion/index.d.ts",
      "svelte": "./dist/motion/index.js",
      "default": "./dist/motion/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./llms.txt": "./llms.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "bin",
    "scripts/mcp-server.mjs",
    "scripts/mcp-core.mjs",
    "docs/gen/components.json",
    "docs/demos",
    "llms.txt",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build:demo": "vite build",
    "package": "svelte-package -o dist && publint",
    "prepare": "svelte-package -o dist",
    "prepack": "svelte-package -o dist && node scripts/docs-data.mjs && node scripts/llms.mjs --check",
    "prepublishOnly": "pnpm check && pnpm test && publint",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "llms": "node scripts/llms.mjs",
    "kit:check": "pnpm --filter tallao-kit-check build && pnpm --filter tallao-kit-check test",
    "mcp": "node scripts/mcp-server.mjs",
    "docs:data": "node scripts/docs-data.mjs",
    "docs:dev": "node scripts/docs-data.mjs && vite --config vite.docs.config.js",
    "docs:build": "node scripts/docs-data.mjs && vite build --config vite.docs.config.js",
    "docs:check": "node scripts/docs-data.mjs && svelte-check --tsconfig ./docs/tsconfig.json"
  },
  "peerDependencies": {
    "@codemirror/commands": "^6",
    "@codemirror/lang-javascript": "^6",
    "@codemirror/lang-json": "^6",
    "@codemirror/lang-markdown": "^6",
    "@codemirror/language": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "leaflet": "^1.9.4",
    "sveaflet": "^0.1.5",
    "svelte": "^5.29.0",
    "@lezer/highlight": "^1"
  },
  "peerDependenciesMeta": {
    "leaflet": {
      "optional": true
    },
    "sveaflet": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "@codemirror/commands": {
      "optional": true
    },
    "@codemirror/language": {
      "optional": true
    },
    "@codemirror/lang-markdown": {
      "optional": true
    },
    "@codemirror/lang-json": {
      "optional": true
    },
    "@codemirror/lang-javascript": {
      "optional": true
    },
    "@lezer/highlight": {
      "optional": true
    }
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/leaflet": "^1.9.22",
    "axe-core": "^4.14.0",
    "happy-dom": "^18.0.1",
    "jsdom": "^26.1.0",
    "leaflet": "^1.9.4",
    "publint": "^0.3.25",
    "sveaflet": "^0.1.5",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18"
  }
}
