{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm test)",
      "Bash(pnpm package)",
      "Bash(pnpm build:demo)",
      "Bash(pnpm kit:check)",
      "Bash(pnpm vitest run:*)",
      "Bash(pnpm exec vitest run:*)",
      "Bash(pnpm exec svelte-check:*)",
      "Bash(pnpm --filter tallao-kit-check build)",
      "Bash(pnpm --filter tallao-kit-check test)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git fetch:*)",
      "Bash(git push -u origin:*)",
      "Bash(git push origin:*)",
      "Bash(git push)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(pnpm publish:*)",
      "Bash(npm publish:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --delete:*)",
      "Bash(git push origin --delete:*)",
      "Bash(gh pr merge:*)"
    ]
  }
}
