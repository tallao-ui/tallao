{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm test)",
      "Bash(pnpm package)",
      "Bash(pnpm build:demo)",
      "Bash(pnpm kit:check)",
      "Bash(pnpm vitest run:*)",
      "Bash(pnpm exec vitest run:*)",
      "Bash(pnpm exec svelte-check:*)",
      "Bash(pnpm --filter tallao-kit-check build)",
      "Bash(pnpm --filter tallao-kit-check test)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(git push:*)",
      "Bash(pnpm publish:*)",
      "Bash(npm publish:*)"
    ]
  }
}
